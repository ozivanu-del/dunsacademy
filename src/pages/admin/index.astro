---
import Layout from '../../layouts/Layout.astro';
import content from '../../data/content.json';
---

<Layout title={`Admin — ${content.site.title}`}>
	<main class="admin-shell">
		<section id="login-view" class="login-view">
			<div class="login-brand"><span class="brand-mark">D</span><span>Dun's Academy</span></div>
			<div class="login-card">
				<div class="login-icon" aria-hidden="true">✦</div>
				<p class="kicker">Content studio</p>
				<h1>Selamat datang kembali.</h1>
				<p class="muted">Masuk untuk mengelola pesan yang tampil di website Dun's Academy.</p>
				<form id="login-form" class="login-form">
					<label for="password">Password admin</label>
					<div class="password-wrap"><input id="password" name="password" type="password" autocomplete="current-password" placeholder="Masukkan password" required /><button id="toggle-password" class="icon-button" type="button" aria-label="Tampilkan password">◉</button></div>
					<button class="primary-button" type="submit">Masuk ke dashboard <span aria-hidden="true">→</span></button>
					<p id="error" class="error" role="alert" hidden>Password yang dimasukkan salah.</p>
				</form>
				<p class="login-note"><span aria-hidden="true">⌁</span> Workspace privat untuk tim Dun's Academy</p>
			</div>
			<p class="login-footer">© 2026 Dun's Academy · <a href="/">Kembali ke website</a></p>
		</section>

		<section id="dashboard-view" class="dashboard-view" hidden>
			<header class="topbar">
				<div class="brand"><span class="brand-mark">D</span><span><strong>Dun's Academy</strong><small>Content studio</small></span></div>
				<div class="top-actions"><a class="view-site" href="/" target="_blank">Lihat website <span aria-hidden="true">↗</span></a><button id="logout" class="avatar" type="button" aria-label="Keluar">DA</button></div>
			</header>
			<div class="dashboard-layout">
				<aside class="sidebar"><p class="sidebar-label">Workspace</p><a class="nav-item active" href="#overview"><span>◈</span> Ringkasan</a><a class="nav-item" href="#content-form"><span>✎</span> Konten halaman</a><a class="nav-item" href="#content-form"><span>⚙</span> Pengaturan</a><div class="sidebar-bottom"><p class="sidebar-label">Status</p><div class="status-card"><span class="status-dot"></span><span>Mode lokal aktif<small>Perubahan tersimpan di browser</small></span></div></div></aside>
				<div class="dashboard-content">
					<div id="overview" class="page-heading"><div><p class="kicker">Selamat datang, admin</p><h1>Kelola konten dengan mudah.</h1><p class="muted">Satu ruang untuk menjaga komunikasi Dun's Academy tetap konsisten.</p></div><div class="date-chip">● Live preview</div></div>
					<div class="stats-grid"><article class="stat-card"><span class="stat-icon purple">✦</span><div><strong>4</strong><span>Section aktif</span></div></article><article class="stat-card"><span class="stat-icon orange">↗</span><div><strong>100%</strong><span>Siap diedit</span></div></article><article class="stat-card"><span class="stat-icon green">✓</span><div><strong id="last-saved">Draft</strong><span>Status perubahan</span></div></article></div>
					<div class="editor-heading"><div><h2>Konten halaman</h2><p class="muted">Pilih section untuk memperbarui teks landing page.</p></div><p class="autosave"><span class="status-dot"></span> Tersimpan otomatis di browser</p></div>
					<form id="content-form" class="content-form">
						<fieldset class="editor-card"><legend><span class="section-number">01</span><span><strong>Hero</strong><small>Pesan pertama yang dilihat pengunjung</small></span><span class="legend-status">● Aktif</span></legend><div class="field-grid"><label>Eyebrow<input name="hero.eyebrow" value={content.hero.eyebrow} /></label><label>CTA button<input name="hero.cta" value={content.hero.cta} /></label></div><label>Judul utama<input name="hero.title" value={content.hero.title} /></label><label>Deskripsi<textarea name="hero.description" rows="3">{content.hero.description}</textarea></label></fieldset>
						<fieldset class="editor-card"><legend><span class="section-number">02</span><span><strong>About</strong><small>Bangun kepercayaan dan koneksi</small></span><span class="legend-status">● Aktif</span></legend><label>Eyebrow<input name="about.eyebrow" value={content.about.eyebrow} /></label><label>Judul<input name="about.title" value={content.about.title} /></label><label>Deskripsi<textarea name="about.description" rows="3">{content.about.description}</textarea></label></fieldset>
						<fieldset class="editor-card"><legend><span class="section-number">03</span><span><strong>Program</strong><small>Jelaskan penawaran utama</small></span><span class="legend-status">● Aktif</span></legend><label>Eyebrow<input name="program.eyebrow" value={content.program.eyebrow} /></label><label>Judul<input name="program.title" value={content.program.title} /></label><label>Deskripsi<textarea name="program.description" rows="3">{content.program.description}</textarea></label></fieldset>
						<fieldset class="editor-card"><legend><span class="section-number">04</span><span><strong>Kontak</strong><small>Ajak pengunjung mengambil tindakan</small></span><span class="legend-status">● Aktif</span></legend><div class="field-grid"><label>Eyebrow<input name="contact.eyebrow" value={content.contact.eyebrow} /></label><label>Email<input name="contact.email" type="email" value={content.contact.email} /></label></div><label>Judul<input name="contact.title" value={content.contact.title} /></label><label>Deskripsi<textarea name="contact.description" rows="3">{content.contact.description}</textarea></label><label>CTA button<input name="contact.cta" value={content.contact.cta} /></label></fieldset>
						<div class="save-bar"><p id="status" role="status"></p><div><button id="reset" class="secondary-button" type="button">Kembalikan default</button><button class="primary-button" type="submit">Simpan perubahan <span aria-hidden="true">✓</span></button></div></div>
					</form>
					<footer class="dashboard-footer">Dun's Academy Admin <span>·</span> v1.0</footer>
				</div>
			</div>
		</section>
	</main>
</Layout>

<script define:vars={{ defaultContent: content }}>
	const login = document.querySelector('#login-form');
	const loginView = document.querySelector('#login-view');
	const dashboard = document.querySelector('#dashboard-view');
	const editor = document.querySelector('#content-form');
	const savedContent = JSON.parse(localStorage.getItem('dunsacademy-content') || 'null');

	const setValue = (name, value) => { const field = editor.querySelector(`[name="${name}"]`); if (field) field.value = value || ''; };
	const fillEditor = (values) => Object.entries(values).forEach(([section, fields]) => Object.entries(fields).forEach(([field, value]) => setValue(`${section}.${field}`, value)));
	const showDashboard = (authenticated) => { loginView.hidden = authenticated; dashboard.hidden = !authenticated; if (authenticated && savedContent) fillEditor(savedContent); };
	login.addEventListener('submit', (event) => { event.preventDefault(); if (new FormData(login).get('password') !== 'dunsacademy-admin') { document.querySelector('#error').hidden = false; return; } sessionStorage.setItem('dunsacademy-auth', '1'); showDashboard(true); });
	editor.addEventListener('submit', (event) => { event.preventDefault(); const next = structuredClone(defaultContent); for (const [key, value] of new FormData(editor)) { const [section, field] = key.split('.'); next[section][field] = value; } localStorage.setItem('dunsacademy-content', JSON.stringify(next)); document.querySelector('#status').textContent = '✓ Perubahan berhasil disimpan'; document.querySelector('#last-saved').textContent = 'Baru saja'; });
	document.querySelector('#reset').addEventListener('click', () => { localStorage.removeItem('dunsacademy-content'); fillEditor(defaultContent); document.querySelector('#status').textContent = 'Konten dikembalikan ke default'; document.querySelector('#last-saved').textContent = 'Default'; });
	document.querySelector('#logout').addEventListener('click', () => { sessionStorage.removeItem('dunsacademy-auth'); showDashboard(false); });
	document.querySelector('#toggle-password').addEventListener('click', () => { const password = document.querySelector('#password'); password.type = password.type === 'password' ? 'text' : 'password'; });
	showDashboard(sessionStorage.getItem('dunsacademy-auth') === '1');
</script>

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) { margin: 0; color: #18202f; background: #f7f8fc; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
	:global(button), :global(input), :global(textarea) { font: inherit; }
	:global(button) { cursor: pointer; }
	.admin-shell { min-height: 100vh; background: radial-gradient(circle at 10% -10%, #ebe8ff 0, transparent 35%), #f7f8fc; }
	.login-view { display: grid; min-height: 100vh; place-items: center; padding: 2rem 1rem; }
	.login-brand { position: absolute; top: 2rem; left: 2.5rem; display: flex; align-items: center; gap: .65rem; color: #111827; font-weight: 800; }
	.brand-mark { display: grid; width: 2.15rem; height: 2.15rem; place-items: center; border-radius: .7rem; color: #fff; background: #5b4bdb; font-family: Georgia, serif; font-size: 1.25rem; }
	.login-card { width: min(440px, 100%); padding: 2.75rem; border: 1px solid #e8e9f1; border-radius: 1.35rem; background: rgba(255,255,255,.92); box-shadow: 0 2rem 5rem #312e8112; }
	.login-icon { display: grid; width: 3rem; height: 3rem; margin-bottom: 1.5rem; place-items: center; border-radius: .9rem; color: #6356dc; background: #efedff; font-size: 1.4rem; }
	.kicker { margin: 0 0 .5rem; color: #6758dc; font-size: .72rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
	h1, h2, p { margin-top: 0; } h1 { margin-bottom: .75rem; font-size: clamp(2rem, 5vw, 2.75rem); letter-spacing: -.05em; line-height: 1.05; } h2 { margin-bottom: .35rem; font-size: 1.35rem; letter-spacing: -.03em; }
	.muted { color: #747b8f; line-height: 1.65; }
	.login-form { display: grid; gap: .65rem; margin-top: 2rem; } label { display: grid; gap: .45rem; color: #343b4c; font-size: .8rem; font-weight: 750; } input, textarea { width: 100%; border: 1px solid #dfe2eb; border-radius: .65rem; outline: none; background: #fff; color: #172033; transition: border-color .2s, box-shadow .2s; } input { padding: .78rem .9rem; } textarea { padding: .8rem .9rem; resize: vertical; } input:focus, textarea:focus { border-color: #7668e6; box-shadow: 0 0 0 3px #7668e622; }
	.password-wrap { position: relative; } .password-wrap input { padding-right: 3rem; } .icon-button { position: absolute; top: .3rem; right: .3rem; width: 2.25rem; height: 2.25rem; border: 0; border-radius: .45rem; color: #8d92a2; background: transparent; }
	.primary-button, .secondary-button { border: 0; border-radius: .6rem; font-weight: 750; } .primary-button { display: inline-flex; align-items: center; justify-content: center; gap: .65rem; padding: .82rem 1.1rem; color: #fff; background: #5b4bdb; box-shadow: 0 .5rem 1rem #5b4bdb24; } .primary-button:hover { background: #4c3dc9; } .login-form .primary-button { width: 100%; margin-top: .7rem; }
	.error { margin: .5rem 0 0; color: #c24152; font-size: .8rem; } .login-note { margin: 2rem 0 0; color: #9a9eaa; font-size: .73rem; text-align: center; } .login-footer { position: absolute; bottom: 1.5rem; color: #9a9eaa; font-size: .75rem; } a { color: inherit; }
	.topbar { display: flex; height: 5rem; align-items: center; justify-content: space-between; padding: 0 2.5rem; border-bottom: 1px solid #e8e9f1; background: #fff; } .brand, .top-actions, .view-site, .status-card, .editor-heading, .save-bar, .date-chip { display: flex; align-items: center; } .brand { gap: .65rem; } .brand > span:last-child { display: grid; gap: .1rem; } .brand small { color: #9a9eaa; font-size: .65rem; } .top-actions { gap: 1rem; } .view-site { gap: .35rem; color: #666d80; font-size: .78rem; text-decoration: none; } .avatar { width: 2.35rem; height: 2.35rem; border: 0; border-radius: 50%; color: #fff; background: #e36a78; font-size: .68rem; font-weight: 800; }
	.dashboard-layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); min-height: calc(100vh - 5rem); } .sidebar { display: flex; flex-direction: column; padding: 2rem 1rem; border-right: 1px solid #e8e9f1; background: #fff; } .sidebar-label { margin: 0 1rem .75rem; color: #a0a4b1; font-size: .65rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; } .nav-item { display: flex; align-items: center; gap: .7rem; padding: .72rem 1rem; border-radius: .6rem; color: #7a8193; font-size: .8rem; text-decoration: none; } .nav-item span { width: 1rem; color: #9da2b2; text-align: center; } .nav-item.active, .nav-item:hover { color: #5547ce; background: #f0efff; } .nav-item.active span { color: #5547ce; } .sidebar-bottom { margin-top: auto; } .status-card { gap: .6rem; padding: .8rem; border: 1px solid #ececf3; border-radius: .7rem; color: #5d6475; font-size: .7rem; } .status-card span:last-child { display: grid; gap: .15rem; } .status-card small { color: #a0a4b1; font-size: .62rem; }
	.dashboard-content { width: min(100%, 1000px); padding: 3.25rem clamp(1.25rem, 5vw, 4rem); } .page-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; } .page-heading h1 { max-width: 580px; } .date-chip { gap: .4rem; margin-top: .4rem; padding: .5rem .75rem; border: 1px solid #dfdfeb; border-radius: 999px; color: #687083; background: #fff; font-size: .7rem; } .date-chip::first-letter { color: #35a66a; }
	.stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 2rem 0 3rem; } .stat-card { display: flex; align-items: center; gap: .9rem; padding: 1.15rem; border: 1px solid #e6e7ef; border-radius: .85rem; background: #fff; } .stat-card > div { display: grid; gap: .15rem; } .stat-card strong { font-size: 1.3rem; letter-spacing: -.04em; } .stat-card div span { color: #9297a7; font-size: .7rem; } .stat-icon { display: grid; width: 2.25rem; height: 2.25rem; place-items: center; border-radius: .65rem; font-weight: 800; } .purple { color: #6254d8; background: #efedff; } .orange { color: #d17a38; background: #fff2e6; } .green { color: #369969; background: #e9f8f0; }
	.editor-heading { justify-content: space-between; gap: 1rem; margin-bottom: 1rem; } .autosave { color: #969bab; font-size: .7rem; } .status-dot { display: inline-block; width: .45rem; height: .45rem; border-radius: 50%; background: #4eb77c; box-shadow: 0 0 0 .2rem #4eb77c1c; } .content-form { display: grid; gap: 1rem; } .editor-card { min-width: 0; margin: 0; padding: 1.35rem; border: 1px solid #e6e7ef; border-radius: .9rem; background: #fff; } .editor-card legend { display: flex; width: 100%; align-items: center; gap: .75rem; padding: 0; color: #21283a; } .editor-card legend > span:nth-child(2) { display: grid; gap: .15rem; } .editor-card legend small { color: #9a9eaa; font-size: .68rem; font-weight: 500; } .section-number { display: grid; width: 2.1rem; height: 2.1rem; place-items: center; border-radius: .6rem; color: #6356dc; background: #efedff; font-size: .68rem; font-weight: 800; } .legend-status { margin-left: auto; color: #4ba977; font-size: .65rem; font-weight: 650; } .editor-card > label, .field-grid { margin-top: 1rem; } .field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
	.save-bar { justify-content: space-between; gap: 1rem; padding-top: .7rem; } #status { margin: 0; color: #40966b; font-size: .78rem; } .secondary-button { padding: .82rem 1rem; margin-right: .55rem; color: #656c7d; background: #e9eaf0; } .dashboard-footer { margin-top: 3rem; color: #a0a4b1; font-size: .7rem; } .dashboard-footer span { margin: 0 .4rem; }
	[hidden] { display: none !important; }
	@media (max-width: 760px) { .login-brand { left: 1.25rem; } .login-card { padding: 2rem 1.35rem; } .topbar { padding: 0 1.25rem; } .dashboard-layout { display: block; } .sidebar { display: none; } .dashboard-content { padding: 2.25rem 1rem; } .stats-grid { gap: .6rem; } .stat-card { padding: .85rem .7rem; gap: .55rem; } .stat-card strong { font-size: 1.05rem; } .stat-card div span { font-size: .62rem; } .page-heading, .editor-heading, .save-bar { display: block; } .date-chip, .autosave { width: fit-content; margin-top: 1rem; } .save-bar > div { margin-top: 1rem; } }
	@media (max-width: 480px) { .stats-grid { grid-template-columns: 1fr; } .stat-card { display: flex; } .view-site { display: none; } .field-grid { grid-template-columns: 1fr; } .secondary-button { margin-bottom: .5rem; } }
</style>
